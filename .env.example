# Salin berkas ini menjadi .env (di folder yang sama), lalu isi kunci API Anda.
# .env tidak ikut ter-commit (tercantum di .gitignore). Jangan isi kunci di berkas .env.example.

# Kunci Claude API dari https://console.anthropic.com (Settings > API Keys)
ANTHROPIC_API_KEY=

# Model Claude untuk mengenali keluhan teks bebas dan menulis narasi (level ESI tetap diputuskan aturan)
CLAUDE_MODEL=claude-haiku-5-5

# Opsional
# LLM_ENABLED=1
# KG_BACKEND=auto
# GRAPHDB_URL=http://127.0.0.1:7201
