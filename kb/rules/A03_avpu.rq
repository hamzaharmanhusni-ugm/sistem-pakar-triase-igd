# A03 (Gilboy 2012, Gambar 2-1 A dan Tabel 2-2): IF AVPU = P atau U THEN kandidat ESI 1
PREFIX ex: <http://example.org/triage/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX prov: <http://www.w3.org/ns/prov#>
INSERT {
  ?case ex:candidateESI ex:ESI_1 .
  ?inf a ex:Inference ; ex:usedRule ex:Rule_A03 ; ex:aboutCase ?case ; ex:concluded ex:ESI_1 ; ex:reason ?why .
}
WHERE {
  ?case a ex:TriageCase ; ex:avpu ?a . FILTER(?a IN ("P", "U"))
  BIND(IRI(CONCAT(STR(?case), "_inf_A03")) AS ?inf)
  BIND(CONCAT("Kesadaran AVPU = ", ?a, IF(?a = "P", " (hanya merespons nyeri)", " (tidak merespons)")) AS ?why)
}
