# F01 (Singer 2016, Sepsis-3): IF dewasa DAN qSOFA >= 2 (RR >= 22, SBP <= 100, status mental berubah) THEN QSOFAPositiveCase dan kandidat ESI 2
PREFIX ex: <http://example.org/triage/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX prov: <http://www.w3.org/ns/prov#>
INSERT {
  ?case a ex:QSOFAPositiveCase ; ex:candidateESI ex:ESI_2 .
  ?inf a ex:Inference ; ex:usedRule ex:Rule_F01 ; ex:aboutCase ?case ; ex:concluded ex:ESI_2 ; ex:reason ?why .
}
WHERE {
  ?case a ex:TriageCase .
  OPTIONAL { ?case ex:ageMonths ?m } OPTIONAL { ?case ex:age ?y }
  BIND(COALESCE(?m, ?y * 12) AS ?months)
  FILTER(?months >= 216)
  OPTIONAL { ?case ex:respRate ?rr } OPTIONAL { ?case ex:sbp ?s } OPTIONAL { ?case ex:avpu ?a }
  BIND(EXISTS { ?case ex:presentsWith ?f . ?f a ex:AlteredMentalStatus } || (BOUND(?a) && ?a != "A") AS ?mental)
  BIND(IF(BOUND(?rr) && ?rr >= 22, 1, 0) AS ?c1)
  BIND(IF(BOUND(?s) && ?s <= 100, 1, 0) AS ?c2)
  BIND(IF(?mental, 1, 0) AS ?c3)
  BIND(?c1 + ?c2 + ?c3 AS ?score)
  FILTER(?score >= 2)
  BIND(IRI(CONCAT(STR(?case), "_inf_F01")) AS ?inf)
  BIND(CONCAT("qSOFA = ", STR(?score), "/3 (RR >= 22: ", STR(?c1), ", SBP <= 100: ", STR(?c2), ", status mental: ", STR(?c3), "), curiga sepsis") AS ?why)
}
