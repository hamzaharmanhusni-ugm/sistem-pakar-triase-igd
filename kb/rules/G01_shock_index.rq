# G01 (Allgower dan Burri 1967): IF usia > 8 tahun DAN HR / SBP >= 1,0 THEN peringatan shock index (ESI tidak berubah)
PREFIX ex: <http://example.org/triage/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX prov: <http://www.w3.org/ns/prov#>
INSERT {
  ?case ex:hasAlert ex:Alert_ShockIndex .
  ?inf a ex:Inference ; ex:usedRule ex:Rule_G01 ; ex:aboutCase ?case ; ex:concluded ex:Alert_ShockIndex ; ex:reason ?why .
}
WHERE {
  ?case a ex:TriageCase ; ex:heartRate ?hr ; ex:sbp ?s . FILTER(?s > 0)
  OPTIONAL { ?case ex:ageMonths ?m } OPTIONAL { ?case ex:age ?y }
  BIND(COALESCE(?m, ?y * 12) AS ?months)
  FILTER(?months >= 96)
  BIND(?hr / ?s AS ?si) FILTER(?si >= 1.0)
  BIND(IRI(CONCAT(STR(?case), "_inf_G01")) AS ?inf)
  BIND(CONCAT("Shock index = ", STR(?hr), "/", STR(?s), " = ", STR(ROUND(?si * 100) / 100), " (ambang >= 1,0)") AS ?why)
}
