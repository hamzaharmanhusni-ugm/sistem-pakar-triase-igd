# B02 (Gilboy 2012, Bab 3): IF bingung/letargi/disorientasi baru ATAU AVPU = V THEN kandidat ESI 2
PREFIX ex: <http://example.org/triage/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX prov: <http://www.w3.org/ns/prov#>
INSERT {
  ?case ex:candidateESI ex:ESI_2 .
  ?inf a ex:Inference ; ex:usedRule ex:Rule_B02 ; ex:aboutCase ?case ; ex:concluded ex:ESI_2 ; prov:used ?f ; ex:reason ?why .
}
WHERE {
  ?case a ex:TriageCase .
  {
    ?case ex:presentsWith ?f . ?f a ex:AlteredMentalStatus ; skos:prefLabel ?l .
    BIND(CONCAT("Perubahan status mental baru: ", STR(?l)) AS ?why)
  } UNION {
    ?case ex:avpu "V" .
    BIND("Kesadaran AVPU = V (hanya merespons suara)" AS ?why)
  }
  BIND(IRI(CONCAT(STR(?case), "_inf_B02")) AS ?inf)
}
