# D01 (Gilboy 2012, Gambar 2-1 D dan Gambar 5-1): IF nilai tanda vital melewati ambang danger zone kelompok usianya THEN DangerZoneCase
# Ambang dibaca dari graph (individu ex:DangerZoneThreshold), bukan ditulis di aturan.
PREFIX ex: <http://example.org/triage/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
INSERT {
  ?case a ex:DangerZoneCase .
  ?inf a ex:Inference ; ex:usedRule ex:Rule_D01 ; ex:aboutCase ?case ; ex:concluded ex:DangerZoneCase ;
       prov:used ?t ; ex:reason ?why .
}
WHERE {
  ?case a ex:TriageCase ; ?p ?val .
  ?p ex:measures ?vital .
  OPTIONAL { ?case ex:ageMonths ?m } OPTIONAL { ?case ex:age ?y }
  BIND(COALESCE(?m, ?y * 12) AS ?months)
  ?t a ex:DangerZoneThreshold ; ex:onVital ?vital ; ex:forAgeGroup ?g ; ex:comparator ?cmp ; ex:limit ?lim .
  ?g ex:minMonths ?lo ; ex:maxMonths ?hi ; rdfs:label ?gl .
  FILTER(?months >= ?lo && ?months < ?hi)
  FILTER((?cmp = "gt" && ?val > ?lim) || (?cmp = "lt" && ?val < ?lim))
  ?vital rdfs:label ?vl .
  BIND(IRI(CONCAT(STR(?case), "_inf_D01_", STRAFTER(STR(?t), "triage/"))) AS ?inf)
  BIND(CONCAT(?vl, " = ", STR(?val), IF(?cmp = "gt", " > ", " < "), STR(?lim), " (kelompok usia ", ?gl, ")") AS ?why)
}
