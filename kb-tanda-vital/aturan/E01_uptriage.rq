# E01: IF kasus adalah DangerZoneCase THEN kandidat ESI 2 (uptriage)
# Aturan ini bergantung pada hasil D01, dicatat dengan ex:dependsOn untuk penjelasan HOW.
PREFIX ex: <http://example.org/triage-vital/>
PREFIX prov: <http://www.w3.org/ns/prov#>
INSERT {
  ?case ex:candidateESI ex:ESI_2 .
  ?inf a ex:Inference ; ex:usedRule ex:Rule_E01 ; ex:aboutCase ?case ; ex:concluded ex:ESI_2 ; ex:dependsOn ?d ; ex:reason ?why .
}
WHERE {
  ?case a ex:DangerZoneCase .
  ?d ex:usedRule ex:Rule_D01 ; ex:aboutCase ?case .
  BIND(IRI(CONCAT(STR(?case), "_inf_E01")) AS ?inf)
  BIND("Tanda vital di danger zone: naikkan ke ESI 2" AS ?why)
}
