# A02: IF SpO2 di bawah ambang kritis THEN kandidat ESI 1
# Ambang tidak ditulis di sini: dibaca dari ex:Threshold yang ex:usedBy ex:Rule_A02 (pengetahuan.ttl).
PREFIX ex: <http://example.org/triage-vital/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
INSERT {
  ?case ex:candidateESI ex:ESI_1 .
  ?inf a ex:Inference ; ex:usedRule ex:Rule_A02 ; ex:aboutCase ?case ; ex:concluded ex:ESI_1 ; prov:used ?t ; ex:reason ?why .
}
WHERE {
  ?case a ex:TriageCase ; ?p ?v . ?p ex:measures ?vs .
  ?t ex:usedBy ex:Rule_A02 ; ex:onVital ?vs ; ex:limit ?lim ; rdfs:label ?l .
  FILTER(?v < ?lim)
  BIND(IRI(CONCAT(STR(?case), "_inf_A02")) AS ?inf)
  BIND(CONCAT("SpO2 ", STR(?v), " memenuhi ", ?l) AS ?why)
}
