# G01: IF nadi / TD sistolik >= ambang shock index THEN peringatan (tidak mengubah level ESI)
PREFIX ex: <http://example.org/triage-vital/>
PREFIX prov: <http://www.w3.org/ns/prov#>
INSERT {
  ?case ex:hasAlert ex:Alert_ShockIndex .
  ?inf a ex:Inference ; ex:usedRule ex:Rule_G01 ; ex:aboutCase ?case ; ex:concluded ex:Alert_ShockIndex ; prov:used ex:Limit_ShockIndex ; ex:reason ?why .
}
WHERE {
  ?case a ex:TriageCase ; ex:heartRate ?hr ; ex:sbp ?sbp . FILTER(?sbp > 0)
  ex:Limit_ShockIndex ex:limit ?lim .
  BIND(ROUND(?hr / ?sbp * 100) / 100 AS ?si)
  FILTER(?hr / ?sbp >= ?lim)
  BIND(IRI(CONCAT(STR(?case), "_inf_G01")) AS ?inf)
  BIND(CONCAT("Shock index ", STR(?si), " (ambang >= ", STR(?lim), ")") AS ?why)
}
